# Base path for API calls — the Vite dev server proxies this to the deployed
# backend (see vite.config.ts) so the refresh-token cookie stays same-origin.
VITE_API_BASE_URL=/api/v1

# Demo accounts for the login page quick-fill buttons
VITE_DEMO_TECHNICIAN_EMAIL=sarah.chen@example.com
VITE_DEMO_MANAGER_EMAIL=priya.sharma@example.com
VITE_DEMO_PASS=Demo1234!
